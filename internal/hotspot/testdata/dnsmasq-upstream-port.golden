# dnsmasq configuration generated by Caspian-BYOC.
# Rewritten from scratch on every start. Edits here are lost.
#
# This file serves DHCP and DNS to the hotspot only. Two things in it
# are not tuning and must not be relaxed: what it refuses to log, and
# where it is allowed to send a query.

# WHO THIS PROCESS RUNS AS.
#
# dnsmasq needs root only to bind port 53 and to open the DHCP socket.
# It then drops to an unprivileged account for the rest of its life,
# which is right, and which is exactly why this line has to be here.
#
# THE FAILURE THIS PREVENTS IS SILENCE, NOT AN ERROR. With no user=
# line dnsmasq drops to its own compiled-in default account, which on a
# Debian-derived system is neither root nor this appliance's service
# user. The lease file below lives in a directory that is mode 0700 and
# owned by the service user (docs/LAYOUT.md: /var/lib/caspian, 0700,
# caspian), and a process running as somebody else cannot traverse it.
# So dnsmasq keeps answering DNS, keeps handing out addresses, and
# keeps failing to record a single lease. The hotspot works. The panel
# reads an empty lease file and reports zero connected devices for
# ever, on a network people are actively using. Nothing logs an error,
# nothing crashes, and a non-technical user is left comparing a screen
# that says nobody is connected against a phone that is plainly online.
#
# group= is set for the same reason and is not implied by user=:
# dnsmasq's default group is a compiled-in value of its own, so leaving
# it out leaves half the identity unstated.
user=caspian
group=caspian

# Listen on the hotspot interface only.
#
# bind-interfaces stops dnsmasq binding the wildcard address. Without
# it dnsmasq listens on 0.0.0.0 and filters by interface in userspace,
# which means the port is open on the uplink and on any interface that
# appears later, and this box would be an open resolver to whatever
# network it is plugged into.
interface=wlan0
bind-interfaces
listen-address=192.168.66.1
port=53

# PRIVACY, NOT TUNING: no query logging.
#
# There is deliberately no log-queries line. With it, dnsmasq writes one
# syslog line per lookup, which on this box is a dated record of every
# site every person on the hotspot visited, kept on the appliance that
# exists to stop exactly that being collected elsewhere. The reference
# implementation set log-queries (004-hotspot/install.sh:352).
#
# The cache below is in memory only. It is lost when the process stops
# and is never written to disk.
cache-size=1000

# PRIVACY, NOT TUNING: no DHCP logging.
#
# Leaving out log-dhcp is not enough. dnsmasq logs every DHCPDISCOVER,
# DHCPOFFER, DHCPREQUEST and DHCPACK by default, each carrying a MAC
# address and a hostname, so the default configuration keeps a dated
# record of every device that joined and when. quiet-dhcp turns that
# off. The reference implementation went the other way and set log-dhcp
# (004-hotspot/install.sh:381).
#
# The lease file remains, because the panel has to show the user how
# many devices are connected. It holds current leases only and dnsmasq
# removes an entry when it expires; it is not a history.
quiet-dhcp
quiet-dhcp6
quiet-ra

# The only place a client query may go.
#
# no-resolv stops dnsmasq reading /etc/resolv.conf. Without it dnsmasq
# inherits whatever resolver the uplink's DHCP handed this box, and
# every client lookup would leave in plaintext beside the tunnel
# instead of through it. That is the leak the whole appliance exists to
# prevent, and it would be caused by a file this program never wrote.
#
# The server line points at a resolver on this machine, which the rest
# of this program routes through the tunnel. A public resolver must
# never appear here; the renderer refuses to emit one that is not a
# loopback address.
no-resolv
server=127.0.0.1#15353

# Do not send a bare name with no dot upstream, and do not send reverse
# lookups for private address space upstream. Both would hand the names
# and addresses of devices on this hotspot to a stranger, and neither
# has a useful answer.
domain-needed
bogus-priv

# Do not answer clients from this box's /etc/hosts.
no-hosts

# DHCP.
#
# dhcp-authoritative is correct because this box is the only DHCP
# server on its own hotspot: it lets dnsmasq answer a client that
# arrives asking to renew a lease from some other network immediately,
# instead of leaving it to time out.
#
# option:dns-server points at this box, not at a public resolver, so a
# client that honours DHCP asks us. A client with a hardcoded resolver
# ignores this line; catching that one is internal/netcfg's redirect,
# not this file's job.
dhcp-authoritative
dhcp-range=192.168.66.50,192.168.66.150,255.255.255.0,12h
dhcp-option=option:router,192.168.66.1
dhcp-option=option:dns-server,192.168.66.1
# The lease file is the panel's only source for the connected-device
# count, and it is writable only because of the user= line at the top
# of this file. Change one without the other and the count silently
# stays at zero.
dhcp-leasefile=/var/lib/caspian/dnsmasq.leases
