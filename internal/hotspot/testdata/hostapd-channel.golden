# hostapd configuration generated by Caspian-BYOC.
# Rewritten from scratch on every start. Edits here are lost.
#
# Every setting below is here for a reason and the reason is written down.
# Where a setting exists because of a known failure, the failure is named.

interface=wlan0
driver=nl80211

# The regulatory domain.
#
# WHY THIS LINE IS FIRST AMONG EQUALS: with no country_code the driver
# uses the world regulatory domain, in which most channels are
# passive-scan only and beaconing is not permitted, so hostapd starts,
# fails to bring the interface up and the network never appears. The
# user sees nothing at all, which is the least diagnosable failure this
# appliance can produce. The reference implementation omitted it
# entirely: 004-hotspot/install.sh:415-430 writes no country_code line.
#
# ieee80211d advertises the domain in the beacon so joining clients
# adopt the same channel and power rules.
country_code=GB
ieee80211d=1

# The network name. utf8_ssid tells hostapd the bytes are UTF-8, which
# matters because this appliance's users name their networks in scripts
# other than Latin and a name advertised in the wrong encoding shows up
# on phones as replacement characters.
ssid=Caspian
utf8_ssid=1

hw_mode=g
channel=1

# 802.11n.
#
# Without ieee80211n the radio negotiates 802.11g rates only and the
# whole hotspot is capped at 54 Mbps shared between every joined device,
# below what the tunnel can carry. The reference implementation set
# neither ieee80211n nor wmm_enabled=1 (004-hotspot/install.sh:415-430,
# which has wmm_enabled=0), so every box it built ran at 54 Mbps and
# nothing said so.
#
# wmm_enabled=1 is not optional here: hostapd disables HT rates when WMM
# is off, so ieee80211n=1 with wmm_enabled=0 silently stays at 54 Mbps
# and looks configured.
ieee80211n=1
wmm_enabled=1

# 20 MHz channel width only.
#
# HT40 needs a secondary channel declared as [HT40+] or [HT40-], and the
# correct one depends on the primary channel and the regulatory domain.
# A wrong secondary makes hostapd refuse to start. This appliance is
# frequently pinned to whatever channel the uplink already uses (see
# RadioConstraint), so the primary is not ours to choose and the safe
# gain is the short guard interval at 20 MHz.
ht_capab=[SHORT-GI-20]

# Security: WPA2-PSK with CCMP (AES) and nothing else.
#
# auth_algs=1 is Open System only. The value 2 enables WEP shared-key
# authentication, which is broken.
#
# There is deliberately NO wpa_pairwise line. wpa_pairwise sets the
# cipher for WPA1, and the reference implementation set
# wpa_pairwise=TKIP (004-hotspot/install.sh:428). That has two costs,
# not one: it advertises a cipher with known practical attacks, and
# because 802.11n forbids HT rates on a BSS that offers TKIP it also
# holds the whole network at 54 Mbps however much 802.11n is enabled
# above. Omitting the line leaves rsn_pairwise as the only cipher suite,
# which is WPA2 with AES.
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=<redacted:wpa-passphrase sha256=d9a4656722e472f9 len=23>

# Devices that join must not be able to reach each other.
#
# Everyone here is a guest of whoever holds the passphrase, and a phone
# joining a shared hotspot should not be exposed to the other phones on
# it. ap_isolate stops hostapd bridging frames from one associated
# station to another. It is not the whole of client isolation: traffic
# that leaves the interface and comes back is internal/netcfg's firewall
# to stop, and this line does not claim to do that job.
ap_isolate=1

# No MAC filtering, and the name is broadcast. A hidden SSID is not
# security, it only stops the user finding their own network.
macaddr_acl=0
ignore_broadcast_ssid=0

# Logging: notification level and above.
#
# hostapd writes a line for every association and disassociation, each
# carrying a device's MAC address, at informational level. This box does
# not keep a record of which devices were here. Errors stay visible so
# the panel can explain a failure.
logger_syslog=-1
logger_syslog_level=3
logger_stdout=-1
logger_stdout_level=3

# Control socket. Used only by this program, to ask hostapd whether the
# access point is actually up rather than merely running: a hostapd
# process that is alive and beaconing nothing is the failure a process
# check cannot see.
ctrl_interface=/run/hostapd
ctrl_interface_group=0
