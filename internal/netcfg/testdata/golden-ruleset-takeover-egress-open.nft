# Caspian-BYOC generated firewall ruleset. Do not edit by hand:
# it is regenerated and replaced atomically on every start.
#
# uplink=eth0 hotspot=wlan0 tunnel=xray0 hotspot-subnet=10.83.51.0/24
# egress=open forward=normal
#
# Every interface match below is by NAME and never by index. Index matching
# is resolved when the ruleset loads, so a ruleset naming xray0 by index cannot
# be loaded while the tunnel is down, and that is exactly when it has to be
# in force. Name matching is resolved per packet and loads with no tunnel.

table inet caspian
delete table inet caspian

table inet caspian {
	chain input {
		type filter hook input priority filter; policy accept;

		# THE POLICY IS ACCEPT, DELIBERATELY, AND THIS IS THE PART TO READ
		# BEFORE CHANGING ANYTHING IN THIS CHAIN.
		#
		# This appliance controls FORWARDED client traffic. It does not decide
		# what the owner may run on their own machine, and it does not close
		# their administrative access to it.
		#
		# An earlier version had policy drop and accepted nothing arriving on
		# eth0. Measured on the target on 2026-08-30: the moment it loaded,
		# every NEW inbound connection to the box was dropped and SSH stopped
		# answering. Existing connections kept working, because of the
		# conntrack rule that used to sit here, so the box looked healthy from
		# the session that was already open while being unreachable to every
		# new one. On a headless machine in another room that is indistinguishable
		# from a crash, and the remaining recovery is a power cycle and a card
		# reader.
		#
		# Accepting here does NOT weaken a host firewall the owner installs.
		# Every base chain registered at this hook is traversed, so a drop in
		# their own table still drops. This policy only stops THIS program
		# from installing a host firewall nobody asked it for.
		#
		# What is still guarded is the hotspot, where the untrusted devices
		# are. A joined device reaches the services this box offers it and
		# nothing else.

		# Before the conntrack check, so loopback is never subject to a
		# conntrack edge case.
		iifname "lo" accept
		ct state invalid drop comment "malformed or out-of-state, not new inbound"

		# The tunnel device. Redundant under an accept policy and kept
		# explicit: the design calls for an INPUT permit for it, and it is
		# what would carry the engine's own traffic if this policy were ever
		# tightened.
		iifname "xray0" accept comment "tunnel: a router's own traffic is INPUT, not FORWARD"

		# The hotspot side, and the only place this chain restricts anything.
		# These are the services the box actually serves to joined devices.
		iifname "wlan0" ct state established,related accept
		iifname "wlan0" udp dport 67 accept comment "DHCP server for clients"
		iifname "wlan0" udp dport 53 accept comment "client DNS, after the prerouting redirect"
		iifname "wlan0" tcp dport 53 accept comment "client DNS over TCP"
		iifname "wlan0" tcp dport 8088 accept comment "panel"
		meta nfproto ipv4 iifname "wlan0" icmp type echo-request accept
		iifname "wlan0" drop comment "a joined device reaches nothing else on this box"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		# THE LEAK BLOCK, and the reason this whole file exists.
		# When the tunnel device disappears the kernel withdraws every route
		# through it and client traffic falls back to the main table and out of
		# the uplink, so "the engine stopped" leaks by default instead of
		# stopping. This rule names only the hotspot and the uplink, so the
		# tunnel's absence cannot affect it, and it is first so that nothing
		# added below can precede it.
		iifname "wlan0" oifname "eth0" drop comment "fail-closed: client traffic never leaves by the uplink"

		# There is no IPv6 tunnel. A client with a working IPv6 path prefers
		# it over IPv4 and would bypass the tunnel entirely.
		meta nfproto ipv6 iifname "wlan0" drop comment "no IPv6 tunnel: clients get no IPv6"
		meta nfproto ipv6 oifname "wlan0" drop

		# DNS over TLS and DNS over QUIC would carry a client's queries past the
		# resolver on this box. Rejecting 853 makes a client fall back to port
		# 53, which prerouting redirects. DNS over HTTPS on 443 is not
		# distinguishable from other HTTPS and is carried through the tunnel
		# like anything else, which is a limit of this design and not an
		# oversight.
		iifname "wlan0" tcp dport 853 reject with tcp reset comment "DNS over TLS"
		iifname "wlan0" udp dport 853 drop comment "DNS over QUIC"

		iifname "wlan0" oifname "wlan0" drop comment "client isolation"

		ct state invalid drop

		# The only way out for a client, and the only way back in. Both name
		# the tunnel, so both stop matching when it is gone, leaving the policy
		# above to drop everything.
		meta nfproto ipv4 iifname "wlan0" oifname "xray0" ip saddr 10.83.51.0/24 accept
		meta nfproto ipv4 iifname "xray0" oifname "wlan0" ip daddr 10.83.51.0/24 accept
	}

	chain output {
		type filter hook output priority filter; policy accept;

		# Stated explicitly, and accept rather than drop. The box's own traffic
		# is outside the fail-closed guarantee, because the engine has to reach
		# the server through the uplink for the tunnel to exist at all. The
		# promise this ruleset makes covers forwarded client traffic only.
		#
		# This is EgressOpen, which is not the default. It exists as the way
		# back for a user on a network nobody thought about, without a rebuild.
		oifname "xray0" accept comment "tunnel: a router's own traffic is OUTPUT, not FORWARD"

		# Never advertise an IPv6 prefix to clients while there is no IPv6
		# tunnel: an autoconfigured client would prefer v6 and bypass it.
		oifname "wlan0" icmpv6 type nd-router-advert drop
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;

		# Redirected, not merely permitted. A client with a resolver hardcoded
		# into it must be answered by this box rather than allowed out to reach
		# the one it was told to use: redirect rewrites the destination address
		# to this box, so the query is answered here whatever it was aimed at.
		iifname "wlan0" udp dport 53 redirect to :53
		iifname "wlan0" tcp dport 53 redirect to :53
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;

		# Deliberately empty.
		# No masquerade towards eth0: source NAT there is the leak this whole
		# ruleset exists to prevent, and it is the single line that would
		# quietly turn the appliance into an ordinary router.
		# No masquerade towards xray0 either: that device is a userspace netstack
		# which terminates TCP and UDP flows and dials out itself, so a
		# client's source address never reaches the wire and there is nothing
		# to translate. Options.MasqueradeToTunnel turns it on for the case
		# where the tunnel is a real layer 3 interface.
	}
}
