{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "dnsLog": false
  },
  "dns": {
    "servers": [
      "9.9.9.9",
      "1.1.1.3",
      "185.228.168.9"
    ],
    "queryStrategy": "UseIP",
    "tag": "resolver-in"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "name": "xray0",
        "MTU": 1500,
        "userLevel": 0
      }
    },
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "socks",
      "settings": {
        "address": "example.invalid",
        "email": "",
        "level": 0,
        "pass": "not-a-real-password",
        "port": 1080,
        "user": "caspian-fake-user"
      },
      "tag": "proxy",
      "targetStrategy": ""
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ruleTag": "resolver-through-tunnel",
        "inboundTag": [
          "resolver-in"
        ],
        "outboundTag": "proxy"
      },
      {
        "ruleTag": "private-direct",
        "ip": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "224.0.0.0/4",
          "240.0.0.0/4",
          "255.255.255.255/32",
          "::1/128",
          "fc00::/7",
          "fe80::/10",
          "ff00::/8"
        ],
        "outboundTag": "direct"
      },
      {
        "ruleTag": "everything-else",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}
