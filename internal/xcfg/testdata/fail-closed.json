{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "dnsLog": false
  },
  "dns": {
    "servers": [
      "9.9.9.9",
      "1.1.1.3",
      "185.228.168.9"
    ],
    "queryStrategy": "UseIP",
    "tag": "resolver-in"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "protocol": "tun",
      "settings": {
        "name": "xray0",
        "MTU": 1500,
        "userLevel": 0
      }
    },
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "ruleTag": "reject-all",
        "network": "tcp,udp",
        "outboundTag": "block"
      }
    ]
  }
}
