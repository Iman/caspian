# Copy to local/box.env and fill in. local/ is gitignored; this example is not,
# so nothing real belongs in this file.
#
# SPDX-License-Identifier: AGPL-3.0-or-later

# The hotspot name the harness asserts the phone is joined to. Not a secret.
# The WPA2 passphrase is a secret and is deliberately NOT here: the harness
# never needs it, because the phone is joined by hand once and remembers.
HOTSPOT_SSID=Caspian

# The Pi's address on the hotspot interface. Used for the fail-closed
# positive control: the phone must still reach the panel while reaching
# nothing else. Read it from the panel's advanced view, or from
#   ip -br addr show ap0
HOTSPOT_ADDR=10.83.51.1
HOTSPOT_IFACE=ap0
PANEL_PORT=8088
PANEL_URL=http://10.83.51.1:8088/

# ssh to the Pi. Needed for the DNS check and the firewall check. The account
# must be able to run tcpdump and nft under sudo without a password prompt:
#   ssh $PI_SSH 'sudo -n tcpdump --version'
PI_SSH=pi@caspian.local

# Optional. Left blank, the harness reads the uplink from the default route.
UPLINK_IFACE=
